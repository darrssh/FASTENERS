# Copy to .env and fill in for local development.
# In production (Render) set these as environment variables instead.

# Local dev default is SQLite; point at PostgreSQL for real use, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/fasteners
DATABASE_URL=sqlite:///./fasteners.db

# Generate a strong secret: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Seeded admin account (created on first boot if it does not exist)
ADMIN_EMAIL=admin@fasteners.local
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated allowed browser origins (the storefront URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://darrssh.github.io

# Public URL of this API once deployed (optional, docs/links only)
PUBLIC_BASE_URL=

# Set to false to skip seeding on boot
SEED_ON_STARTUP=true
